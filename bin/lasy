#!/usr/bin/env bash
# lasy launcher.  lasy [start|stop|restart|status|logs|doctor|path]
set -uo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
VENV="$REPO/.venv"
PORT="${LASY_PORT:-8847}"
URL="http://127.0.0.1:$PORT"
DATA="$HOME/.local/share/lasy"
LOG="$DATA/backend.log"
mkdir -p "$DATA"

is_up() { curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1; }

start_backend() {
  if is_up; then return 0; fi
  [ -x "$VENV/bin/uvicorn" ] || { echo "lasy is not installed yet. Run: bash $REPO/scripts/install.sh"; exit 1; }
  echo "Starting lasy…"
  ( cd "$REPO/backend" && setsid nohup "$VENV/bin/uvicorn" lasy_backend.main:app \
      --host 127.0.0.1 --port "$PORT" >"$LOG" 2>&1 < /dev/null & )
  for _ in $(seq 1 80); do is_up && return 0; sleep 0.25; done
  echo "lasy did not start. See the log: $LOG"; tail -n 15 "$LOG"
  grep -qi "address already in use" "$LOG" 2>/dev/null && echo "Port $PORT is in use by another program. Try:  LASY_PORT=9000 lasy"
  exit 1
}

open_url() {
  if command -v wslview >/dev/null 2>&1; then wslview "$1" >/dev/null 2>&1
  elif command -v powershell.exe >/dev/null 2>&1; then powershell.exe -NoProfile -Command "Start-Process '$1'" >/dev/null 2>&1
  elif command -v cmd.exe >/dev/null 2>&1; then cmd.exe /c start "" "$1" >/dev/null 2>&1
  else return 1; fi
}

case "${1:-start}" in
  start)
    start_backend
    open_url "$URL" || echo "Open this address in your browser: $URL"
    echo "lasy is running at $URL"
    ;;
  stop)
    pkill -f "uvicorn lasy_backend.main:app" && echo "lasy stopped." || echo "lasy was not running."
    ;;
  restart)
    pkill -f "uvicorn lasy_backend.main:app" 2>/dev/null; sleep 1; "$0" start
    ;;
  status)
    if is_up; then echo "lasy is running at $URL"; else echo "lasy is not running."; fi
    ;;
  logs)
    tail -n 80 -f "$LOG"
    ;;
  doctor)
    ( cd "$REPO/backend" && "$VENV/bin/python" -m lasy_backend.doctor )
    ;;
  path)
    echo "$REPO"
    ;;
  *)
    echo "Usage: lasy [start|stop|restart|status|logs|doctor]"; exit 2
    ;;
esac
